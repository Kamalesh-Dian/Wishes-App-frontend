# ==========================================
# Wishes AI Frontend Environment Variables
# ==========================================

# Base API URL pointing to the Express backend (Required)
VITE_API_URL=http://localhost:5000/api

# Frontend application public URL (Required for OAuth redirects)
VITE_APP_URL=http://localhost:5173

# Firebase Authentication (Required)
# Retrieve these credentials from your Firebase Console under Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Microsoft Entra ID / Azure AD (Required for OneDrive sync)
# Retrieve these from Azure Portal > App registrations > Overview
VITE_MS_CLIENT_ID=your_azure_client_id_guid_here
VITE_MS_TENANT_ID=common # or your specific tenant ID GUID
